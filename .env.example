# Postgres connection string (Railway provides this automatically when you
# add a "Postgres" plugin to your project - copy its DATABASE_URL here for
# local development, or reference it as ${{Postgres.DATABASE_URL}} in Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_menu?schema=public"

# Secret used to sign admin session cookies. Generate a strong random value,
# e.g. `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial admin dashboard credentials (used only the first time you run the
# seed script - change the password after logging in for real usage)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
