# Used for local `next dev` only (Cloudflare bindings for D1/R2 are proxied
# automatically via initOpenNextCloudflareForDev() in next.config.mjs - no
# DATABASE_URL needed, D1 replaces it entirely).
#
# In production these are set as Worker secrets, NOT in this file:
#   npx wrangler secret put AUTH_SECRET
#   npx wrangler secret put ADMIN_USERNAME
#   npx wrangler secret put ADMIN_PASSWORD

# Secret used to sign admin session cookies. Generate a strong random value,
# e.g. `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial admin dashboard credentials (used only when generating the seed SQL
# via `npm run cf:seed:gen` - change the password after logging in for real usage)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
