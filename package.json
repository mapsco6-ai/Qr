{
  "name": "restaurant-qr-menu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "cf:types": "wrangler types",
    "cf:seed:gen": "tsx scripts/generate-d1-seed.ts",
    "cf:migrate:local": "wrangler d1 migrations apply khan-al-jamr-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply khan-al-jamr-db --remote",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wrangler": "4.129.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
