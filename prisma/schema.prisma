generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Placeholder only - the actual D1 database is supplied at runtime via the
  // Cloudflare D1 binding (see src/lib/prisma.ts), not this connection string.
  url      = "file:./local.db"
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  order     Int        @default(0)
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id            String   @id @default(cuid())
  name          String
  description   String?
  image         String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  productCost   Float    @default(0)
  saladCost     Float    @default(0)
  oldPrice      Float    @default(0)
  newPrice      Float    @default(0)

  isOffer       Boolean  @default(false)
  offerNote     String?

  active        Boolean  @default(true)
  order         Int      @default(0)

  reviews       Review[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
}

model Review {
  id          String    @id @default(cuid())
  customerName String
  rating      Int
  comment     String?
  approved    Boolean   @default(false)
  menuItemId  String?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([menuItemId])
}

model Complaint {
  id           String   @id @default(cuid())
  customerName String
  phone        String?
  message      String
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Settings {
  id        String   @id @default("main")
  siteName  String   @default("خان الجمر")
  tagline   String   @default("سيّد المشويات التركية")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}
